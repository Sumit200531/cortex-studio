# Cortex Studio configuration — copy to .env and edit.
# Every value is optional. With nothing set, Cortex uses Ollama on this machine.

PORT=3000

# ---- Local & free: Ollama (default) ----
# Install from https://ollama.com, then: ollama pull qwen2.5:7b
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:7b
# Optional lighter model for quick actions (explain, expand, quiz, ask, "Fast" maps)
# AI_MODEL_FAST=qwen2.5:3b

# ---- Or a free hosted provider (OpenAI-compatible) ----
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=your_key_here
# AI_MODEL=copy-a-current-model-id-from-the-provider

# ---- Limits ----
AI_MAX_TOKENS=2500
RATE_LIMIT_PER_MIN=30
# AI_APP_URL=https://your-deployed-site.example
